# Production environment (used by docker-compose.prod.yml). Never commit the real file.

# ---------- Database container ----------
POSTGRES_USER=threevo
# Use a long random password without URL special characters, or URL-encode it.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=threevo_db

# ---------- App ----------
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1
SITE_URL=https://threevo.id
API_URL=https://api.threevo.id
CORS_ORIGINS=https://threevo.id,https://www.threevo.id
TRUST_PROXY=1
LOG_LEVEL=info

# ---------- Auth ----------
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
COOKIE_DOMAIN=.threevo.id
COOKIE_SECURE=true

# ---------- Mail ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Threevo <no-reply@threevo.id>"
LEAD_NOTIFICATION_EMAIL=

# ---------- CAPTCHA ----------
TURNSTILE_SECRET_KEY=

# ---------- Upload ----------
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=5

# ---------- Tracking ----------
TRACKING_PROVIDER=mock
TRACKING_API_URL=
TRACKING_API_KEY=
TRACKING_TIMEOUT_MS=8000

# ---------- Misc ----------
CACHE_TTL_SECONDS=300
ENABLE_DOCS=false

# ---------- Seeder (first deploy only) ----------
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@threevo.id
SEED_ADMIN_PASSWORD=
