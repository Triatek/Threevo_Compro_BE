# ---------- App ----------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
SITE_URL=http://localhost:5173
API_URL=http://localhost:4000
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Set to 1 when running behind Nginx/Cloudflare
TRUST_PROXY=0
LOG_LEVEL=info

# ---------- Database ----------
# Docker:          postgresql://threevo:threevo_secret@localhost:5432/threevo_db?schema=public
# Local Postgres:  postgresql://postgres:YOUR_PASSWORD@localhost:5432/threevo_db?schema=public
DATABASE_URL=postgresql://threevo:threevo_secret@localhost:5432/threevo_db?schema=public

# ---------- Auth ----------
# Min 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ---------- Mail (empty SMTP_HOST = log emails only) ----------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
MAIL_FROM="Threevo <no-reply@example.com>"
LEAD_NOTIFICATION_EMAIL=

# ---------- CAPTCHA (empty = verification skipped) ----------
TURNSTILE_SECRET_KEY=

# ---------- Upload ----------
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=5

# ---------- Tracking ----------
# mock | http
TRACKING_PROVIDER=mock
TRACKING_API_URL=
TRACKING_API_KEY=
TRACKING_TIMEOUT_MS=8000

# ---------- Misc ----------
CACHE_TTL_SECONDS=300
ENABLE_DOCS=true

# ---------- Seeder ----------
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@threevo.local
# Empty = random password printed to the console (non-production only)
SEED_ADMIN_PASSWORD=
